# Neon Postgres (recommended)
# Pooled URL — use the "-pooler" host for the app (Prisma queries)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
# Direct URL — use the non-pooler host for migrations (prisma migrate)
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# Supabase Auth (required) — create a project at supabase.com
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
# In Supabase: Authentication → Providers → enable Email (password sign-in)
# In Supabase: Authentication → URL Configuration → Site URL http://localhost:3000
#   Redirect URLs: http://localhost:3000/auth/callback

OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_MODEL="gpt-4o-mini"

# Debounce delay (ms) before auto-saving edits (default: 1000)
NEXT_PUBLIC_SAVE_DEBOUNCE_MS=1000
